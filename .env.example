# Copy this file to ".env" (same folder) and fill in your real key.
# ".env" itself is gitignored -- it will never be committed.
#
# Used by the AI Agents module (blueprints/ai_agents.py's "Run Agent"
# button, via ai_extraction.py) to actually read a run's Sources and
# propose field values for review. Nothing else in TMS needs this --
# every other feature, including entering review items by hand, works
# with no key at all.
#
# Get a key at https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional -- override the model used for extraction. Left unset, TMS
# defaults to a current Claude Sonnet model; if a "Run Agent" call fails
# with a model-not-found error, check
# https://docs.claude.com/en/docs/about-claude/models and set the exact
# model ID here.
# ANTHROPIC_MODEL=claude-sonnet-5
# Model the AI Image Collector uses to review and caption photos (cheaper vision model).
# ANTHROPIC_VISION_MODEL=claude-haiku-4-5
# Separate key for the platform-level TMS Agents (billed to the platform, not tenants).
# Leave unset to use ANTHROPIC_API_KEY.
# PLATFORM_ANTHROPIC_API_KEY=sk-ant-...
